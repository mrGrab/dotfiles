conky.config = {
    -- Placement
    alignment = 'middle_left',
    gap_x = 8,
    gap_y = 0,
    minimum_width = 200,
    minimum_height = 900,
    maximum_width = 250,
    border_inner_margin = 10,

    -- Window (Wayland / wlr-layer-shell)
    own_window = true,
    own_window_type = 'desktop',
    own_window_class = 'Conky',
    own_window_colour = '#00000000',
    out_to_wayland = true,
    out_to_x = false,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    background = false,

    -- Fonts / text
    use_xft = true,
    font = 'Noto Sans Mono:size=10',
    default_color = '#5F9EA0',
    default_shade_color = '#000000',
    default_outline_color = '#000000',
    uppercase = false,
    extra_newline = false,
    use_spacer = 'none',
    top_name_width = 16,

    -- Drawing
    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
    draw_graph_borders = true,
    show_graph_scale = false,
    show_graph_range = false,

    -- Sampling
    update_interval = 2.0,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    no_buffers = true,
}

conky.text = [[
${font Noto Sans:bold:size=14}Info${font}
$hr
  Distro:    Arch Linux
  Kernel:    $kernel
  Uptime:    $uptime_short
  Hostname:  $nodename
  Processes: $processes Running: $running_processes

${font Noto Sans:bold:size=14}Temperature${font}
$hr
  CPU:  ${hwmon k10temp temp 1} °C     GPU: ${execi 10 nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits} °C
  NVMe: ${hwmon nvme temp 1} °C     Board: ${hwmon gigabyte_wmi temp 1} °C

${font Noto Sans:bold:size=14}CPU${font}
$hr
  Frequency: ${freq_g 1} GHz
  CPU usage: ${cpu cpu0}%
  ${cpugraph cpu0 50,220 -t}
${font Noto Sans:bold:size=14}Memory${font}
$hr
  RAM           ${mem}/${memmax}
  ${membar 5}
  Swap          ${swap}/${swapmax}
  ${swapbar 5}
${font Noto Sans:bold:size=14}File systems${font}
$hr
  root          ${fs_used /}/${fs_size /}
  ${fs_bar 5 /}
  home          ${fs_used /home}/${fs_size /home}
  ${fs_bar 5 /home}
  backups       ${fs_used /backups}/${fs_size /backups}
  ${fs_bar 5 /backups}

${font Noto Sans:bold:size=14}Networking${font}
$hr
  Public IP:      ${curl https://ifconfig.me/ip 60}
  Download speed: ${downspeed enp9s0}
  Upload speed:   ${upspeed enp9s0}

${font Noto Sans:bold:size=14}Processes${font}
$hr
  Name${goto 150}CPU%${goto 200}MEM%
  ${top name 1}${goto 150}${top cpu 1}${goto 200}${top mem 1}
  ${top name 2}${goto 150}${top cpu 2}${goto 200}${top mem 2}
  ${top name 3}${goto 150}${top cpu 3}${goto 200}${top mem 3}
  ${top name 4}${goto 150}${top cpu 4}${goto 200}${top mem 4}
  ${top name 5}${goto 150}${top cpu 5}${goto 200}${top mem 5}
]]
