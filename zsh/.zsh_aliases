#!/usr/bin/env zsh

# My Kubernetes Utility Wrapper
k8s() {
    case "$1" in
    "cluster")
        if [[ "$2" == "list" ]]; then
            kubectl config get-clusters
        elif [[ "$2" == "set" && -n "$3" ]]; then
            kubectl config use-context "$3"
        else
            echo "Usage: k8s cluster {list|set <context>}"
        fi
        ;;
    "pod")
        if [[ "$2" == "ssh" && -n "$3" ]]; then
            local container_flag=""
            [[ -n "$4" ]] && container_flag="-c $4"
            kubectl exec --stdin --tty "$3" ${=container_flag} -- sh -c "(bash || sh)"
        else
            echo "Usage: k8s pod ssh <pod-name> [container-name]"
        fi
        ;;
    "namespace")
        if [[ "$2" == "set" && -n "$3" ]]; then
            kubectl config set-context --current --namespace="$3"
        else
            echo "Usage: k8s namespace set <namespace>"
        fi
        ;;
    *)
        echo "Usage: k8s {cluster|pod|namespace}"
        ;;
    esac
}

_k8s_completions() {
    local cur prev opts
    cur=${words[CURRENT]}
    prev=${words[CURRENT - 1]}
    opts=("cluster" "pod" "namespace")

    case "${prev}" in
    "k8s")
        reply=("${opts[@]}")
        ;;
    "cluster")
        reply=("list" "set")
        ;;
    "pod")
        reply=("ssh")
        ;;
    "namespace")
        reply=("set")
        ;;
    *)
        # Dynamic completions for arguments following specific actions
        if [[ "${words[CURRENT - 2]}" == "cluster" && "$prev" == "set" ]]; then
            # Complete cluster contexts dynamically
            reply=($(kubectl config get-contexts -o name 2>/dev/null))
        elif [[ "${words[CURRENT - 2]}" == "namespace" && "$prev" == "set" ]]; then
            # Complete namespaces dynamically
            reply=($(kubectl get namespaces -o jsonpath='{.items[*].metadata.name}' 2>/dev/null))
        elif [[ "${words[CURRENT - 2]}" == "pod" && "$prev" == "ssh" ]]; then
            # Complete pod names dynamically
            reply=($(kubectl get pods -o jsonpath='{.items[*].metadata.name}' 2>/dev/null))
        else
            reply=()
        fi
        ;;
    esac
    _describe 'command' reply
}

compdef _k8s_completions k8s
