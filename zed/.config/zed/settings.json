// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "collaboration_panel": {
    "button": false
  },
  "outline_panel": {
    "button": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },
  "terminal": {
    "copy_on_select": true,
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "fast": false,
        "model": "default",
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "collaboration_mode": "plan",
      },
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "agent": "",
        "model": "auto",
      },
      "type": "registry",
    },
  },
  "git": {
    "diff_base": "head",
    "path_style": "file_path_first",
    "file_diff": {
      "show_full_file": true,
    },
    "inline_blame": {
      "show_commit_summary": false,
    },
  },
  "git_panel": {
    "diff_stats": true,
    "collapse_untracked_diff": true,
    "button": true,
    "show_count_badge": false,
    "file_icons": false,
    "status_style": "icon",
    "tree_view": false,
    "dock": "left",
    "fallback_branch_name": "master",
  },
  "which_key": {
    "enabled": false,
  },
  "diff_view_style": "unified",
  "edit_predictions": {
    "allow_data_collection": "yes",
    "provider": "zed",
    "ollama": {
      "model": "qwen2.5-coder:1.5b",
    },
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "max_content_width": 820.0,
    "default_width": 640.0,
    "flexible": false,
    "button": true,
    "thinking_display": "preview",
    "auto_compact": {
      "threshold": "70%",
    },
    "expand_terminal_card": false,
    "use_modifier_to_send": false,
    "single_file_review": true,
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow",
        },
        "skill": {
          "default": "allow",
        },
      },
    },
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "auto",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "tabs": {
    "git_status": false,
  },
  "project_panel": {
    "hide_root": true,
    "sticky_scroll": true,
    "scrollbar": {
      "show": "auto"
    },
    "indent_size": 16.0,
    "folder_indicator": "icon",
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "bold_folder_labels": true,
    "git_status": true,
    "file_icons": true,
    "entry_spacing": "standard",
    "default_width": 240.0,
    "dock": "left",
    "button": true,
  },
  "auto_update": false,
  "buffer_line_height": "standard",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "remove_trailing_whitespace_on_save": true,
  "theme": "Nightfox - opaque",
  "format_on_save": "on",
  "languages": {
    "Python": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "Ansible": {
      "semantic_tokens": "combined",
    },
  },
  "file_types": {
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml",
    ],
  },
}
